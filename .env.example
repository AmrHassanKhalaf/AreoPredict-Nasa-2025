# Copy this file to `.env` for local development (`npm run dev` loads it automatically).
# On Vercel, add these names in Project Settings -> Environment Variables instead.

# --- Required for the AI pollution analysis (/api/analyze-environment) ---
# Free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Optional (WeatherAPI current.json cross-check) ---
# Free plan from https://www.weatherapi.com/
# If you leave it empty, the built-in fallback key inside lib/weather-service.ts is used.
WEATHER_API_KEY=

# --- Local production run only (Render / VPS). Not needed on Vercel. ---
# NODE_ENV=production
# PORT=3000
